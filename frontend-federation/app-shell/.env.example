# ---------------------------------------------------------------------------
# Salin berkas ini menjadi .env.local lalu isi dengan nilai proyek Anda.
# .env.local TIDAK PERNAH di-commit ke repository.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Kredensial Firebase Web App.
# Ambil dari: Firebase Console > Project Settings > Your apps > SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mode demo: isi 1 untuk melewati autentikasi saat pengembangan UI.
# Kosongkan atau hapus baris ini untuk mengaktifkan login Firebase.
VITE_DEMO=1
